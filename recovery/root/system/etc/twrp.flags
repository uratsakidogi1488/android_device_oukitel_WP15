# Dynamic partitions
/system ext4 system flags=logical;slotselect;backup=1;wipeingui;display="System"
/vendor ext4 vendor flags=logical;slotselect;backup=1;wipeingui;display="Vendor"
/product ext4 product flags=logical;slotselect;backup=1;wipeingui;display="Product"

# Dynamic images
/system_image emmc system flags=logical;slotselect;backup=1;flashimg=1;display="System Image"
/vendor_image emmc vendor flags=logical;slotselect;backup=1;flashimg=1;display="Vendor Image"
/product_image emmc product flags=logical;slotselect;backup=1;flashimg=1;display="Product Image"

# Encryption metadata
/metadata ext4 /dev/block/by-name/metadata flags=display="Metadata";backup=1

# Core partitions
/data f2fs /dev/block/by-name/userdata flags=display="Data";backup=1;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,fsverity
/boot emmc /dev/block/by-name/boot flags=backup=1;display="Boot";flashimg=1;slotselect
/dtbo emmc /dev/block/by-name/dtbo flags=backup=1;display="Dtbo";flashimg=1;slotselect
/persist ext4 /dev/block/by-name/persist flags=backup=1;display="Persist";mounttodecrypt
/persist_image emmc /dev/block/by-name/persist flags=backup=1;display="Persist Image";mounttodecrypt;flashimg=1
/vbmeta emmc /dev/block/by-name/vbmeta flags=display="Vbmeta";backup=1;flashimg=1;slotselect
/vbmeta_system emmc /dev/block/by-name/vbmeta_system flags=backup=1;display="Vbmeta System";flashimg=1;slotselect
/vbmeta_vendor emmc /dev/block/by-name/vbmeta_vendor flags=backup=1;display="Vbmeta Vendor";flashimg=1;slotselect

# MediaTek core
/bootloader emmc /dev/block/by-name/lk flags=backup=1;display="Bootloader (lk)";flashimg=1;slotselect
/logo emmc /dev/block/by-name/logo flags=display="Logo";backup=1;flashimg=1
/misc emmc /dev/block/by-name/misc
/expdb emmc /dev/block/by-name/expdb flags=display="Expdb";backup=1
/seccfg emmc /dev/block/by-name/seccfg flags=display="SecCfg";backup=1
/para emmc /dev/block/by-name/para flags=display="Para";backup=1;flashimg=1
/boot_para emmc /dev/block/by-name/boot_para flags=display="Boot_para";backup=1
/proinfo emmc /dev/block/by-name/proinfo flags=display="Proinfo";backup=1

# Non-volatile storage
/nvcfg ext4 /dev/block/by-name/nvcfg flags=display="NvCfg";backup=1
/nvdata ext4 /dev/block/by-name/nvdata flags=display="NvData";backup=1
/nvram emmc /dev/block/by-name/nvram flags=display="NvRam";backup=1;flashimg=1

# Security & Radio
/protect_f ext4 /dev/block/by-name/protect1 flags=display="Protect_f";backup=1
/protect_s ext4 /dev/block/by-name/protect2 flags=backup=1;subpartitionof=/protect_f
/tee emmc /dev/block/by-name/tee flags=display="Tee";backup=1;flashimg=1;slotselect
/persistent emmc /dev/block/by-name/frp flags=display="Frp";backup=1;flashimg=1

# Modem firmware
/gz emmc /dev/block/by-name/gz flags=display="Gz";backup=1;slotselect
/md1img emmc /dev/block/by-name/md1img flags=display="Modem";backup=1;flashimg=1;slotselect
/md1dsp emmc /dev/block/by-name/md1dsp flags=display="Md1dsp";backup=1
/md1arm7 emmc /dev/block/by-name/md1arm7
/md3img emmc /dev/block/by-name/md3img

# Hardware modules
/scp emmc /dev/block/by-name/scp flags=display="Scp";backup=1;slotselect
/otp emmc /dev/block/by-name/otp flags=display="Otp";backup=1
/spmfw emmc /dev/block/by-name/spmfw flags=display="Spmfw";backup=1;slotselect
/sspm emmc /dev/block/by-name/sspm flags=display="Sspm";backup=1;slotselect
/pi_img emmc /dev/block/by-name/pi_img flags=display="Pi_img";backup=1;slotselect
/dpm emmc /dev/block/by-name/dpm flags=display="Dpm";backup=1;slotselect
/mcupm emmc /dev/block/by-name/mcupm flags=display="Mcupm";backup=1;slotselect

# External storage
/external_sd auto /dev/block/mmcblk0p1 /dev/block/mmcblk0 flags=display="External_SDcard";storage;wipeingui;removable;fsflags="utf8"
/usbotg auto /dev/block/sdd1 /dev/block/sdd flags=display="Usb_Otg";storage;wipeingui;removable;fsflags="utf8"
