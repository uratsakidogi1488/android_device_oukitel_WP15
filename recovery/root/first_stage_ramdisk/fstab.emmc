# System
/dev/block/mapper/system     /system     ext4   ro   logical

# Vendor
/dev/block/mapper/vendor     /vendor     ext4   ro   logical

# Product
/dev/block/mapper/product    /product    ext4   ro   logical

# Metadata
/dev/block/by-name/metadata  /metadata   ext4   noatime,nosuid,nodev,discard   wait,check,formattable

# Userdata (FBE)
# Упрощено, чтобы TWRP мог расшифровать
/dev/block/by-name/userdata  /data       f2fs   noatime,nosuid,nodev,discard,formattable,quota   wait,check,latemount,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption
