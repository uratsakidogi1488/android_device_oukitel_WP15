system /system ext4 ro slotselect,avb=vbmeta_system,logical,first_stage_mount
vendor /vendor ext4 ro slotselect,avb,logical,first_stage_mount
product /product ext4 ro slotselect,avb,logical,first_stage_mount
/dev/block/by-name/metadata /metadata ext4 noatime,nosuid,nodev wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard wait,check,formattable
